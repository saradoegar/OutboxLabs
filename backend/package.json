{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "ReachInbox Email Scheduler Service & Worker",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/email.worker.js",
    "db:migrate": "node dist/migrate.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/email.worker.ts"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.0",
    "@bull-board/express": "^9.10.0",
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.5.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
